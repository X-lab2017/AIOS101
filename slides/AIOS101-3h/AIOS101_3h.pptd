version: v2
title: AI 开源通识｜3 小时全校授课课件
size:
- 960
- 540
customFonts:
- family: MiSans
  src: https://statics.kimi.ai/neo-design-static/p-font/MiSans.ttf
- family: QuattrocentoSans
  src: https://statics.kimi.ai/neo-design-static/p-font/QuattrocentoSans.ttf
theme:
  colors:
    paper: '#F6F3EB'
    ink: '#1D2433'
    indigo: '#5146D9'
    coral: '#F27A59'
    lavender: '#E7E3FC'
    teal: '#3F958D'
    muted: '#656577'
    line: '#DCD9E1'
    white: '#FFFFFF'
    softcoral: '#FBE7DE'
    softteal: '#E0EFEA'
    softgray: '#ECE9E1'
  textStyles:
    title:
      fontSize: 30
      fontFamily: &id001
        latin: QuattrocentoSans
        ea: MiSans
      color: $ink
      bold: true
      lineHeight: 1.15
    body:
      fontSize: 19
      fontFamily: *id001
      color: $ink
      lineHeight: 1.35
